// navigator.pubky.requestSession(): the browser's Pubky identity for this
// site. navigator.pubky itself also serves HTTP pages; sessions need a secure
// context. See pubky/SESSIONS.md.
[
    ImplementedAs=PubkySessionRequester
] partial interface PubkyCapabilities {
    // `scopes` are capability strings such as "/pub/example.com/:rw".
    [SecureContext, CallWith=ScriptState, RaisesException]
    Promise<PubkySession> requestSession(sequence<DOMString> scopes);
};
